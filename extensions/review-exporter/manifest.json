{
  "manifest_version": 3,
  "name": "ReviewExporter - Amazon Review Downloader",
  "version": "2.0.0",
  "description": "Export Amazon reviews to CSV with one click. Get AI-powered analysis on ReviewMiner.",
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReviewExporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
